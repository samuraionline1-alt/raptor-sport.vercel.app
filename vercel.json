{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|mp4|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(promo-config|promotions|checkout|order-context).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/raptor-speed-water-charge/",
      "destination": "/products/raptor-v-mix/",
      "permanent": true
    },
    {
      "source": "/products/raptor-ice-cold-spray/",
      "destination": "/products/raptor-cooling-spray/",
      "permanent": true
    }
  ]
}
