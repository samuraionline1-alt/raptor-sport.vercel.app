{
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|mp4|css|js|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)\\.(woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(promo-config|promotions|checkout|order-context).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/assets/optimized/raptor-logo-still.webp",
      "destination": "/assets/optimized/raptor-brand-logo.png",
      "permanent": false
    },
    {
      "source": "/assets/optimized/raptor-logo-complete.webp",
      "destination": "/assets/optimized/raptor-brand-logo.png",
      "permanent": false
    },
    {
      "source": "/products/raptor-speed-water-charge/",
      "destination": "/products/raptor-v-mix/",
      "permanent": true
    },
    {
      "source": "/products/raptor-ice-cold-spray/",
      "destination": "/products/raptor-cooling-spray/",
      "permanent": true
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "."
}
